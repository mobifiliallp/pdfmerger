{
  "name": "@mfllp/pdfmerger",
  "version": "0.2.2",
  "description": "Uses the Pdfbox library to merge PDF files into a single PDF file.",
  "main": "./source/index.js",
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "test": "node test.js",
    "prepublishOnly": "npm run jar",
    "setup": "cd source/pdfmerger && mvn clean install",
    "jar": "cd source/pdfmerger && mvn clean compile package"
  },
  "files": [
    "source/index.js",
    "source/lib",
    "jar/pdfmerger.jar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mobifiliallp/pdfmerger.git"
  },
  "keywords": [
    "pdf",
    "merge",
    "combine",
    "pdfbox"
  ],
  "author": "Mobifilia LLP (https://www.github.com/mobifiliallp)",
  "contributors": [
    "Bjørn Bråthen (https://www.github.com/bompi88)"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mobifiliallp/pdfmerger/issues"
  },
  "homepage": "https://github.com/mobifiliallp/pdfmerger#readme",
  "devDependencies": {
    "mkdirp": "^0.5.6",
    "mvn": "^3.5.0",
    "testing": "^1.1.2",
    "trash": "^5.2.0"
  }
}
